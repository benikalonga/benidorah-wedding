# --- Database ---
DATABASE_URL="postgresql://benidorah:changeme@db:5432/benidorah?schema=public"

# --- App ---
NODE_ENV=production
SITE_URL="https://benidorah.com"
PORT=3000

# Host port the `web` container is published to (127.0.0.1 only — see
# docker-compose.yml). This is what the server's nginx reverse-proxies to.
# Pick something free on the box; other apps on the same host use their own.
HOST_PORT=3001

# --- Auth ---
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_NAME="benidorah_admin_session"

# Shared first-login password for every seeded admin account (prisma/seed.ts).
# Pick something you can share with the other admins once, out of band —
# each account forces its own password reset on first login regardless, so
# this value is never a standing credential. Required before seeding a
# production database (the seed script refuses to run without it there).
ADMIN_SEED_PASSWORD="replace-with-a-throwaway-first-login-password"

# --- Media storage ---
UPLOAD_DIR="/data/uploads"
PRIVATE_MEDIA_DIR="/data/private-media"
MAX_UPLOAD_SIZE_MB=100

# --- WhatsApp Cloud API (Meta) ---
# Leave blank to run the invite flow in mock mode (logs instead of sending).
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"

# Name/language of the approved WhatsApp message template (with a video
# header) used for the invite send. Required for real delivery to the
# actual guest list — Meta requires business-initiated messages to use
# an approved template, not free-form text/video. Leave blank and the
# invite falls back to free-form text, which only reaches a guest who
# messaged us first or a registered test number (see lib/whatsapp.ts).
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# --- Public site content (bank details, contact numbers) ---
# These ARE shown to every guest on the live site (Gift Registry / Contact
# sections need them) — they're env-driven purely to keep the real values
# out of the git history, since the source repo is public. Next.js inlines
# NEXT_PUBLIC_* vars into the built client bundle at build time, so set
# real values here on the server before running `next build`.
NEXT_PUBLIC_BANK_ACCOUNT_NAME="Couple Name"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="0000000000"
NEXT_PUBLIC_BANK_ACCOUNT_TYPE="Current account"
NEXT_PUBLIC_BANK_NAME="Bank Name"
NEXT_PUBLIC_BANK_BRANCH_CODE="000000"
NEXT_PUBLIC_CONTACT_DANIELLA_PHONE="+27 00 000 0000"
NEXT_PUBLIC_CONTACT_JONATHAN_PHONE="+27 00 000 0000"

# --- Postgres (docker-compose only) ---
POSTGRES_DB=benidorah
POSTGRES_USER=benidorah
POSTGRES_PASSWORD=changeme
